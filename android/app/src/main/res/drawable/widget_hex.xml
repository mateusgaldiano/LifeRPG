<?xml version="1.0" encoding="utf-8"?>
<!-- Marca d'água hexagonal (o motivo do "System"/radar do LifeRPG). Dois
     hexágonos concêntricos em ciano bem esmaecido — usado como camada de fundo
     do widget. Vetorial: nítido em qualquer tamanho. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Hexágono externo -->
    <path
        android:strokeColor="#1400F2FE"
        android:strokeWidth="1.5"
        android:fillColor="#00000000"
        android:pathData="M90,50 L70,84.64 L30,84.64 L10,50 L30,15.36 L70,15.36 Z" />

    <!-- Hexágono interno -->
    <path
        android:strokeColor="#0F00F2FE"
        android:strokeWidth="1.5"
        android:fillColor="#00000000"
        android:pathData="M74,50 L62,70.78 L38,70.78 L26,50 L38,29.22 L62,29.22 Z" />
</vector>
