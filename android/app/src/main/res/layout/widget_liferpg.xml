<?xml version="1.0" encoding="utf-8"?>
<!-- App Widget do LifeRPG — v1: Atividades (feitas/total) + Masmorra ativa.
     Só views suportadas por RemoteViews (LinearLayout, TextView, ProgressBar).
     Cores inline na identidade do app: fundo Obsidian, ciano #00F2FE (atividades),
     ouro #FBBF24 (masmorra). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <!-- ── ATIVIDADES ─────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ATIVIDADES"
            android:textColor="#8A94A6"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-condensed" />

        <TextView
            android:id="@+id/widget_act_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10 / 20"
            android:textColor="#00F2FE"
            android:textStyle="bold"
            android:textSize="20sp"
            android:fontFamily="sans-serif-condensed" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_act_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="9dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="50"
        android:progressDrawable="@drawable/widget_xp_progress" />

    <!-- ── MASMORRA ───────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MASMORRA"
            android:textColor="#8A94A6"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-condensed" />

        <TextView
            android:id="@+id/widget_dungeon_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳ 14h"
            android:textColor="#FBBF24"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_dungeon_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🗝 Templo Mental"
            android:textColor="#E8EEF5"
            android:textStyle="bold"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_dungeon_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="2 / 3"
            android:textColor="#FBBF24"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_dungeon_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="9dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="66"
        android:progressDrawable="@drawable/widget_dungeon_progress" />

</LinearLayout>
