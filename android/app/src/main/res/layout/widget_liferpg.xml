<?xml version="1.0" encoding="utf-8"?>
<!-- Layout do App Widget do LifeRPG (RemoteViews). Só usa views suportadas por
     RemoteViews: LinearLayout, TextView, ProgressBar. Cores inline (hex) na
     identidade do app: fundo Obsidian, ciano #00F2FE, ouro #FBBF24, esmeralda
     #10B981. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <!-- Linha 1: Nível + Selo do Rank -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_level"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LV 12"
            android:textColor="#E8EEF5"
            android:textStyle="bold"
            android:textSize="22sp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/widget_rank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_rank_badge"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="C"
            android:textColor="#FBBF24"
            android:textStyle="bold"
            android:textSize="15sp"
            android:letterSpacing="0.08" />
    </LinearLayout>

    <!-- Linha 2: Barra de XP -->
    <ProgressBar
        android:id="@+id/widget_xp_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="9dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progress="60"
        android:progressDrawable="@drawable/widget_xp_progress" />

    <TextView
        android:id="@+id/widget_xp_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="780 / 1300 XP"
        android:textColor="#8A94A6"
        android:textSize="11sp"
        android:gravity="end"
        android:fontFamily="monospace" />

    <!-- Linha 3: Streak + Missões restantes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔥 7"
            android:textColor="#FBBF24"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_quests"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚔ 3 missões"
            android:textColor="#10B981"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
