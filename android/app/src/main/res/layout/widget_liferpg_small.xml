<?xml version="1.0" encoding="utf-8"?>
<!-- Widget LifeRPG — layout PEQUENO (~1x1 a 2x1). Só o essencial: atividades
     feitas/total. Usado pelo sistema quando o widget é pequeno. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_bg"
    android:padding="6dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ATIV."
        android:textColor="#8A94A6"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:fontFamily="sans-serif-condensed" />

    <TextView
        android:id="@+id/widget_act_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10/20"
        android:textColor="#00F2FE"
        android:textStyle="bold"
        android:textSize="15sp"
        android:maxLines="1"
        android:fontFamily="sans-serif-condensed" />
</LinearLayout>
